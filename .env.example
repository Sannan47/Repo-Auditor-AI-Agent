# Gemini API key from https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AGENT_MAX_ROUNDS=30
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=4
LLM_RETRY_BASE_SECONDS=5

# Alternative: OpenRouter free tool-calling endpoint (requires an OpenRouter key).
# Replace the three LLM_* provider settings above; do not define them twice.
# LLM_API_KEY=<your OpenRouter key, never commit it>
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# LLM_BASE_URL=https://openrouter.ai/api/v1
