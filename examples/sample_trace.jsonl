{"event": "tool_result", "turn": 6, "name": "read_file", "call_id": "call_1697327", "result": {"path": "tools.py", "total_lines": 113, "lines": [{"line": 1, "text": "\"\"\"Read-only inspection tools. Repository code is never imported or executed.\"\"\""}, {"line": 2, "text": ""}, {"line": 3, "text": "import json"}, {"line": 4, "text": "from pathlib import Path, PurePosixPath"}, {"line": 5, "text": ""}, {"line": 6, "text": "from auditor.repository import AuditError, git_command"}, {"line": 7, "text": "from auditor.safety import sanitize"}, {"line": 8, "text": ""}, {"line": 9, "text": ""}, {"line": 10, "text": "MAX_FILE_BYTES = 512_000"}, {"line": 11, "text": "MAX_OUTPUT_CHARS = 32_000"}, {"line": 12, "text": "MAX_FILES = 10_000"}, {"line": 13, "text": ""}, {"line": 14, "text": ""}, {"line": 15, "text": "class InspectionTools:"}, {"line": 16, "text": "    def __init__(self, root: Path):"}, {"line": 17, "text": "        self.root = root.resolve()"}, {"line": 18, "text": "        self.observed: dict[str, set[int]] = {}"}, {"line": 19, "text": "        self.listing_complete = False"}, {"line": 20, "text": ""}, {"line": 21, "text": "    def _path(self, path: str) -> Path:"}, {"line": 22, "text": "        relative = PurePosixPath(path)"}, {"line": 23, "text": "        if not path or \"\\\\\" in path or relative.is_absolute() or any("}, {"line": 24, "text": "            part in {\"..\", \".git\"} or \":\" in part for part in relative.parts"}, {"line": 25, "text": "        ):"}, {"line": 26, "text": "            raise AuditError(\"Path must be repository-relative and outside .git\")"}, {"line": 27, "text": "        current = self.root"}, {"line": 28, "text": "        for part in relative.parts:"}, {"line": 29, "text": "            current = current / part"}, {"line": 30, "text": "            if current.is_symlink() or current.is_junction():"}, {"line": 31, "text": "                raise AuditError(\"Symbolic links and junctions are not followed\")"}, {"line": 32, "text": "        if not current.resolve().is_relative_to(self.root):"}, {"line": 33, "text": "            raise AuditError(\"Path escapes repository\")"}, {"line": 34, "text": "        return current"}, {"line": 35, "text": ""}, {"line": 36, "text": "    def _files(self) -> list[str]:"}, {"line": 37, "text": "        # Git's tracked paths avoid walking .git or following directory links."}, {"line": 38, "text": "        raw = git_command([\"ls-files\", \"-z\"], cwd=self.root)"}, {"line": 39, "text": "        return sorted(path for path in raw.split(\"\\0\") if path)"}, {"line": 40, "text": ""}, {"line": 41, "text": "    def list_files(self) -> dict:"}, {"line": 42, "text": "        paths = self._files()"}, {"line": 43, "text": "        selected = paths[:MAX_FILES]"}, {"line": 44, "text": "        self.listing_complete = len(paths) <= MAX_FILES"}, {"line": 45, "text": "        return {\"files\": selected, \"total_files\": len(paths), \"truncated\": not self.listing_complete}"}, {"line": 46, "text": ""}, {"line": 47, "text": "    def _read(self, path: str) -> list[str]:"}, {"line": 48, "text": "        target = self._path(path)"}, {"line": 49, "text": "        if not target.is_file():"}, {"line": 50, "text": "            raise AuditError(\"File does not exist or is not a regular file\")"}, {"line": 51, "text": "        with target.open(\"rb\") as stream:"}, {"line": 52, "text": "            data = stream.read(MAX_FILE_BYTES + 1)"}, {"line": 53, "text": "        if len(data) > MAX_FILE_BYTES:"}, {"line": 54, "text": "            raise AuditError(f\"File exceeds the {MAX_FILE_BYTES}-byte inspection limit\")"}, {"line": 55, "text": "        if b\"\\0\" in data:"}, {"line": 56, "text": "            raise AuditError(\"Binary file is not supported by this text inspection tool\")"}, {"line": 57, "text": "        return data.decode(\"utf-8\", errors=\"replace\").splitlines()"}, {"line": 58, "text": ""}, {"line": 59, "text": "    def read_file(self, path: str, start_line: int = 1, end_line: int = 200) -> dict:"}, {"line": 60, "text": "        if type(start_line) is not int or type(end_line) is not int or start_line < 1 or end_line < start_line:"}, {"line": 61, "text": "            raise AuditError(\"Use positive integer line numbers with end_line >= start_line\")"}, {"line": 62, "text": "        lines = self._read(path)"}, {"line": 63, "text": "        selected = []"}, {"line": 64, "text": "        chars = 0"}, {"line": 65, "text": "        for number in range(start_line, min(end_line, len(lines)) + 1):"}, {"line": 66, "text": "            entry = {\"line\": number, \"text\": lines[number - 1]}"}, {"line": 67, "text": "            cost = len(json.dumps(entry))"}, {"line": 68, "text": "            if chars + cost > MAX_OUTPUT_CHARS:"}, {"line": 69, "text": "                break"}, {"line": 70, "text": "            selected.append(entry)"}, {"line": 71, "text": "            chars += cost"}, {"line": 72, "text": "        self.observed.setdefault(path, set()).update(row[\"line\"] for row in selected)"}, {"line": 73, "text": "        last = selected[-1][\"line\"] if selected else start_line - 1"}, {"line": 74, "text": "        return {\"path\": path, \"total_lines\": len(lines), \"lines\": selected,"}, {"line": 75, "text": "                \"truncated\": last < min(end_line, len(lines)),"}, {"line": 76, "text": "                \"more_lines\": last < len(lines), \"next_line\": last + 1 if last < len(lines) else None}"}, {"line": 77, "text": ""}, {"line": 78, "text": "    def search_code(self, pattern: str) -> dict:"}, {"line": 79, "text": "        \"\"\"Case-insensitive literal search avoids untrusted regex execution.\"\"\""}, {"line": 80, "text": "        if not isinstance(pattern, str) or not pattern or len(pattern) > 256:"}, {"line": 81, "text": "            raise AuditError(\"Search pattern must be a nonempty literal string of at most 256 characters\")"}, {"line": 82, "text": "        matches, skipped = [], []"}, {"line": 83, "text": "        chars = 0"}, {"line": 84, "text": "        paths = self._files()"}, {"line": 85, "text": "        for path in paths[:MAX_FILES]:"}, {"line": 86, "text": "            try:"}, {"line": 87, "text": "                lines = self._read(path)"}, {"line": 88, "text": "            except (AuditError, OSError) as exc:"}, {"line": 89, "text": "                if len(skipped) < 50:"}, {"line": 90, "text": "                    skipped.append({\"path\": path, \"reason\": str(exc)})"}, {"line": 91, "text": "                continue"}, {"line": 92, "text": "            for number, line in enumerate(lines, 1):"}, {"line": 93, "text": "                if pattern.casefold() in line.casefold():"}, {"line": 94, "text": "                    entry = {\"file\": path, \"line\": number, \"text\": line}"}, {"line": 95, "text": "                    chars += len(json.dumps(entry))"}, {"line": 96, "text": "                    if len(matches) >= 100 or chars > MAX_OUTPUT_CHARS:"}, {"line": 97, "text": "                        return {\"matches\": matches, \"truncated\": True, \"skipped\": skipped}"}, {"line": 98, "text": "                    matches.append(entry)"}, {"line": 99, "text": "                    self.observed.setdefault(path, set()).add(number)"}, {"line": 100, "text": "        return {\"matches\": matches, \"truncated\": len(paths) > MAX_FILES, \"skipped\": skipped}"}, {"line": 101, "text": ""}, {"line": 102, "text": "    def git_log(self) -> dict:"}, {"line": 103, "text": "        history = git_command([\"--no-pager\", \"log\", \"-30\", \"--format=%h %aI %s\", \"--no-decorate\"], cwd=self.root)"}, {"line": 104, "text": "        return {\"history\": history[:MAX_OUTPUT_CHARS], \"scope\": \"Latest 30 commits from a shallow clone of at most 100 commits\","}, {"line": 105, "text": "                \"truncated\": len(history) > MAX_OUTPUT_CHARS}"}, {"line": 106, "text": ""}, {"line": 107, "text": "    def execute(self, name: str, arguments: dict) -> dict:"}, {"line": 108, "text": "        if name not in {\"list_files\", \"read_file\", \"search_code\", \"git_log\"}:"}, {"line": 109, "text": "            return {\"error\": \"Unknown inspection tool\"}"}, {"line": 110, "text": "        try:"}, {"line": 111, "text": "            return sanitize(getattr(self, name)(**arguments))"}, {"line": 112, "text": "        except (AuditError, OSError, TypeError, ValueError) as exc:"}, {"line": 113, "text": "            return sanitize({\"error\": str(exc)})"}], "truncated": false, "more_lines": false, "next_line": null}}
