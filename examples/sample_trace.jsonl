text": "def main(argv=None):"}, {"line": 33, "text": "    parser = argparse.ArgumentParser(description=\"LLM-directed, read-only DevOps audit of a public GitHub repository\")"}, {"line": 34, "text": "    parser.add_argument(\"--repo\", required=True, help=\"https://github.com/OWNER/REPOSITORY\")"}, {"line": 35, "text": "    parser.add_argument(\"--output\", required=True, type=Path, help=\"Destination JSON report\")"}, {"line": 36, "text": "    parser.add_argument(\"--trace\", type=Path, help=\"Sanitized JSONL trace; default: OUTPUT.trace.jsonl\")"}, {"line": 37, "text": "    args = parser.parse_args(argv)"}, {"line": 38, "text": "    try:"}, {"line": 39, "text": "        url = normalize_url(args.repo)"}, {"line": 40, "text": "        try:"}, {"line": 41, "text": "            from dotenv import load_dotenv"}, {"line": 42, "text": "        except ImportError as exc:"}, {"line": 43, "text": "            raise AuditError(\"Install dependencies with: python -m pip install -r requirements.txt\") from exc"}, {"line": 44, "text": "        # Load only this project's configuration, never files from the inspected repo."}, {"line": 45, "text": "        load_dotenv(Path(__file__).resolve().parent / \".env\", override=False)"}, {"line": 46, "text": "        settings = Settings.from_environment()"}, {"line": 47, "text": "        protect_secret(settings.api_key)"}, {"line": 48, "text": "        output = args.output.resolve()"}, {"line": 49, "text": "        trace_path = (args.trace or Path(str(args.output) + \".trace.jsonl\")).resolve()"}, {"line": 50, "text": "        if output == trace_path:"}, {"line": 51, "text": "            raise AuditError(\"Output and trace paths must be different\")"}, {"line": 52, "text": "        if not output.parent.is_dir() or not trace_path.parent.is_dir():"}, {"line": 53, "text": "            raise AuditError(\"Output and trace parent directories must already exist\")"}, {"line": 54, "text": "        provider = OpenAICompatibleProvider(settings)"}, {"line": 55, "text": "        with tempfile.TemporaryDirectory(prefix=\"devops-audit-\") as work:"}, {"line": 56, "text": "            root = Path(work) / \"repository\""}, {"line": 57, "text": "            with Trace(trace_path) as trace:"}, {"line": 58, "text": "                trace.write(\"started\", repository=url, model=settings.model)"}, {"line": 59, "text": "                clone_repository(url, root)"}, {"line": 60, "text": "                trace.write(\"repository_snapshot\", commit=git_command([\"rev-parse\", \"HEAD\"], cwd=root).strip())"}, {"line": 61, "text": "                tools = InspectionTools(root)"}, {"line": 62, "text": "                report = run_agent(url, tools, provider, trace, settings.max_rounds)"}, {"line": 63, "text": "                write_report(output, report)"}, {"line": 64, "text": "        print(f\"Audit completed: {len(report['violations'])} violation(s). Report: {output}\")"}, {"line": 65, "text": "        return 0"}, {"line": 66, "text": "    except (AuditError, OSError) as exc:"}, {"line": 67, "text": "        print(f\"Audit failed: {redact(str(exc))}\", file=sys.stderr)"}, {"line": 68, "text": "        return 1"}, {"line": 69, "text": "    except KeyboardInterrupt:"}, {"line": 70, "text": "        print(\"Audit interrupted; no completed report was written.\", file=sys.stderr)"}, {"line": 71, "text": "        return 130"}, {"line": 72, "text": ""}, {"line": 73, "text": ""}, {"line": 74, "text": "if __name__ == \"__main__\":"}, {"line": 75, "text": "    sys.exit(main())"}], "truncated": false, "more_lines": false, "next_line": null}}
